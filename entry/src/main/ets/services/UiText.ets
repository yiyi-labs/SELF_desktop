export class UiText {
  /** Standing presentation language, updated whenever the setting changes. Services read it for user-facing messages. */
  static current:string='zh';
  static languages():string[]{return ['zh','en','ja','ko'];}
  /** Native names stay constant in every language so the switch is always readable. */
  static nativeLabel(lang:string):string{return lang==='zh'?'中文':lang==='en'?'English':lang==='ja'?'日本語':'한국어';}
  static get(value:string,language:string):string{
    if(language==='en')return EN[value]||value;
    if(language==='ja')return JA[value]||EN[value]||value;
    if(language==='ko')return KO[value]||EN[value]||value;
    return value;
  }
}
