    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test renderer-web/tests/*.test.ts",
    "test:camera-guidance": "node scripts/test-camera-guidance.mjs",
    "test:star-naming": "node scripts/test-star-naming.mjs",
