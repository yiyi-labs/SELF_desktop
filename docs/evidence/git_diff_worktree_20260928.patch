+@app.post("/v1/conversations")
+async def conversations(request: Request):
+    token = os.getenv("SELF_BACKEND_TOKEN", "")
+    if token:
+        if not hmac.compare_digest(request.headers.get("authorization", ""), "Bearer " + token):
+            raise HTTPException(401, "unauthorized")
+    elif not (os.getenv("SELF_DEV_LOOPBACK") == "1" and request.client and request.client.host in {"127.0.0.1", "::1", "testclient"}):
+        raise HTTPException(503, "backend_auth_not_configured")
+    now = time.monotonic()
+    while story_recent and now-story_recent[0] > 60:
+        story_recent.popleft()
+    if len(story_recent) >= 12 or len(story_inflight) >= 2:
+        raise HTTPException(429, "rate_limit")
+    data = bytearray()
+    async for chunk in request.stream():
+        data.extend(chunk)
+        if len(data) > 32768:
+            raise HTTPException(413, "request_size")
+    try:
+        body = json.loads(data)
+        conversation = ConversationRequest.model_validate(body)
+    except Exception:
+        raise HTTPException(422, "invalid_request") from None
+    if conversation.requestId in story_inflight:
+        raise HTTPException(409, "request_in_progress")
+    story_recent.append(now)
+    story_inflight.add(conversation.requestId)
+    task = asyncio.create_task(converse(conversation))
+    try:
+        while not task.done():
+            await asyncio.wait({task}, timeout=.2)
+            if await request.is_disconnected():
+                task.cancel()
+                raise HTTPException(499, "client_cancelled")
+        return await task
+    except ModelFailure as error:
+        raise HTTPException(502, str(error)) from None
+    finally:
+        if not task.done():
+            task.cancel()
+        story_inflight.discard(conversation.requestId)
+
